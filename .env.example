# =============================================================================
# Rhema Care Flow — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha com suas credenciais.
# NUNCA commit o arquivo .env.local — ele está no .gitignore.
#
# Como obter as credenciais Supabase:
#   1. Acesse https://supabase.com/dashboard
#   2. Selecione seu projeto
#   3. Vá em Settings → API
#   4. Copie "Project URL" e "anon / public key"
# =============================================================================

# URL do projeto Supabase (ex: https://xxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública anon do Supabase (começa com eyJhbGci...)
# Use APENAS a chave "anon/public" — NUNCA a "service_role" no frontend.
VITE_SUPABASE_PUBLISHABLE_KEY=

# =============================================================================
# URV Chain — Matriz Universal Solana
# =============================================================================
# Esta é a única camada que deve permanecer como matriz universal dos derivados
# oficiais do código aberto. Interfaces, especialidades e módulos podem variar;
# a rede URV deve preservar compatibilidade canônica.
#
# Modos:
#   off          = blockchain desligada
#   mock         = simulação local sem transação Solana
#   devnet       = Solana devnet com wallet
#   mainnet-beta = produção futura, somente após auditoria
# =============================================================================

VITE_URV_CHAIN_ENABLED=true
VITE_URV_NETWORK_MODE=devnet
VITE_URV_CLUSTER_URL=https://api.devnet.solana.com
VITE_URV_PROGRAM_ID=URVPr1vacy11111111111111111111111111111111
VITE_URV_SCHEMA_VERSION=1
VITE_URV_ORACLE_MODE=wallet
VITE_URV_CANONICAL_MATRIX=true

# =============================================================================
# URV Split-Key — Dupla autenticação futura
# =============================================================================
# Arquitetura futura:
#   1. Token físico com uma fração-chave do sistema.
#   2. Token virtual/app-side com outra fração-chave.
#
# Objetivo futuro:
#   - dupla autenticação
#   - segurança
#   - auditabilidade
#   - cerimônia de assinatura/emissão URV mais forte
#
# IMPORTANTE PARA DESENVOLVIMENTO:
# Por ora, nenhuma fração-chave deve barrar mock, devnet, build, CI ou evolução
# do app. Mantenha disabled + allow=true até existir fluxo seguro de emissão,
# recuperação, rotação e suporte operacional.
#
# Modos:
#   disabled = previsto, mas não exigido
#   optional = pode ser usado se existir, mas não bloqueia
#   required = bloqueia ambientes restritos, recomendado só para produção futura
# =============================================================================

VITE_URV_PHYSICAL_KEY_FRACTION_MODE=disabled
VITE_URV_VIRTUAL_KEY_FRACTION_MODE=disabled
VITE_URV_ALLOW_DEV_WITHOUT_KEY_FRACTIONS=true

# =============================================================================
# Variáveis opcionais
# =============================================================================

# Chave da API Daily.co para teleconsulta por vídeo
# Sem esta chave, o sistema usa uma sala demo pública (apenas para dev)
# Obtenha em: https://dashboard.daily.co/developers
# VITE_DAILY_CO_API_KEY=
